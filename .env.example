# URL pública do site (usada em SEO, canonical, sitemap, robots, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://brumel.dev

# Token do GitHub (PAT clássico com escopo "read:user") usado só em build-time
# pra buscar o calendário de contribuições exibido no final da página.
# Sem esse token a seção de atividade do GitHub simplesmente não é renderizada.
GH_CONTRIBUTIONS_TOKEN=
